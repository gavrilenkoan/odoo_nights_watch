#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "\"%(castle)s\" already answers to a commander."
msgstr "\"%(castle)s\" уже має коменданта."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_castle.py:0
msgid "\"%(castle)s\" cannot hold more than %(capacity)s brothers."
msgstr "\"%(castle)s\" не вмістить більше ніж %(capacity)s побратимів."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_ranging.py:0
msgid "\"%(name)s\" has already departed."
msgstr "\"%(name)s\" уже вирушила."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_ranging.py:0
msgid "\"%(name)s\" is not beyond the Wall."
msgstr "\"%(name)s\" не за Стіною."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "\"%(role)s\" commands a castle, so %(name)s must be quartered in one."
msgstr "\"%(role)s\" командує замком, тож %(name)s мусить бути приписаний до якогось."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_role.py:0
msgid "\"%(role)s\" heads an order, so it must name which one."
msgstr "\"%(role)s\" очолює орден, тож має бути вказано, який саме."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "\"%(role)s\" is already held by another brother."
msgstr "\"%(role)s\" уже обіймає інший побратим."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid ""
"\"%(role)s\" is an office of a castle, so %(name)s must be quartered in one."
msgstr "\"%(role)s\" — посада замку, тож %(name)s мусить бути приписаний до якогось."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid ""
"\"%(role)s\" is an office of the %(order)s, so %(name)s must belong to that "
"order."
msgstr "\"%(role)s\" — посада ордену %(order)s, тож %(name)s мусить належати до нього."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid ""
"\"%(role)s\" stands above the three orders, so %(name)s belongs to none of "
"them."
msgstr "\"%(role)s\" стоїть над трьома орденами, тож %(name)s не належить до жодного."

#. module: nights_watch
#: model:ir.model.fields,field_description:nights_watch.field_nw_role__brother_count
msgid "# Holders"
msgstr "К-ть носіїв"

#. module: nights_watch
#: model:ir.model.fields,field_description:nights_watch.field_nw_order__member_count
msgid "# Members"
msgstr "К-ть членів"

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "%(name)s has already said the words."
msgstr "%(name)s уже промовив слова."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid ""
"%(name)s has already said the words. The Watch does not release a sworn "
"brother."
msgstr "%(name)s уже промовив слова. Варта не відпускає присяглого побратима."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/res_partner.py:0
msgid "%(name)s has already taken the black."
msgstr "%(name)s уже взяв чорне."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "%(name)s is no longer on the rolls of the Watch."
msgstr "%(name)s більше не значиться в реєстрі Варти."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "%(name)s is not awaiting an assignment."
msgstr "%(name)s не чекає на призначення."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "%(name)s is not lost beyond the Wall."
msgstr "%(name)s не зник за Стіною."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "%(name)s is still awaiting an assignment, so he holds no office yet."
msgstr "%(name)s ще чекає на призначення, тож посади поки не обіймає."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/res_partner.py:0
msgid ""
"%(name)s keeps no book of his own. Give him a login before he takes the "
"black, for the words are his to say."
msgstr "%(name)s не має власної книги. Заведіть йому обліковий запис, перш ніж він візьме чорне, бо слова промовляти йому."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "%(name)s must be posted to a castle before the oath."
msgstr "%(name)s мусить бути приписаний до замку перед присягою."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "%(name)s waits at a castle for its commander to post him. He has none."
msgstr "%(name)s чекає в замку, доки комендант його призначить. Замку в нього немає."

#. module: nights_watch
#: model:ir.actions.report,print_report_name:nights_watch.action_report_nw_brother
msgid "'Dossier - %s' % (object.name)"
msgstr "'Досьє - %s' % (object.name)"

#. module: nights_watch
#: model:ir.actions.report,print_report_name:nights_watch.action_report_nw_ranging
msgid "'Ranging - %s' % (object.name)"
msgstr "'Вилазка - %s' % (object.name)"

#. module: nights_watch
#: model_terms:ir.ui.view,arch_db:nights_watch.view_nw_brother_kanban
msgid "<i class=\"fa fa-fort-awesome me-1\" title=\"Castle\"/>"
msgstr "<i class=\"fa fa-fort-awesome me-1\" title=\"Замок\"/>"

#. module: nights_watch
#: model:ir.model.constraint,message:nights_watch.constraint_nw_brother_serves_not_self
msgid "A brother cannot serve himself."
msgstr "Побратим не може служити сам собі."

#. module: nights_watch
#: model:ir.model.fields,help:nights_watch.field_nw_role__is_senior
msgid "A brother holding this role may be assigned a personal steward."
msgstr "Побратимові на цій посаді можна призначити особистого стюарда."

#. module: nights_watch
#: model:ir.model.constraint,message:nights_watch.constraint_nw_castle_name_uniq
msgid "A castle with this name already exists."
msgstr "Замок із такою назвою вже існує."

#. module: nights_watch
#: model:res.groups,comment:nights_watch.group_nw_officer
msgid ""
"A holder of a senior office. He enrols and posts the men of his own castle, "
"but deletes nothing."
msgstr "Носій старшої посади. Записує й призначає людей свого замку, але нічого не видаляє."
"Носій старшої посади. Записує й призначає людей свого замку, але нічого не "
"видаляє."

#. module: nights_watch
#: model:ir.model.fields,help:nights_watch.field_res_partner__nw_can_take_the_black
#: model:ir.model.fields,help:nights_watch.field_res_users__nw_can_take_the_black
msgid ""
"A man takes the black himself, and no one takes it for him, and he keeps a "
"book of his own so the words are his to say. The Lord Commander keeps the "
"rolls, and may enter a man who walked up to the gate on his own."
msgstr "Чоловік бере чорне сам, і ніхто не бере його замість нього, і має власну книгу, тож слова промовляти йому. Лорд-командувач веде реєстр і може вписати того, хто сам прийшов до брами."
"Чоловік бере чорне сам, і ніхто не бере його замість нього, і має власну "
"книгу, тож слова промовляти йому. Лорд-командувач веде реєстр і може вписати"
" того, хто сам прийшов до брами."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid ""
"A personal steward may only be assigned to a senior brother. %(name)s holds "
"no senior office."
msgstr "Особистого стюарда призначають лише старшому побратимові. %(name)s не обіймає старшої посади."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_ranging.py:0
msgid "A ranging cannot come back before it departs."
msgstr "Вилазка не може повернутися раніше, ніж вирушила."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/wizard/nw_ranging_wizard.py:0
msgid ""
"A ranging is raised from the garrison of one castle. These men answer to "
"another: %(names)s."
msgstr "Загін збирають із залоги одного замку. Ці люди підпорядковані іншому: %(names)s."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_ranging.py:0
#: code:addons/nights_watch/wizard/nw_ranging_wizard.py:0
msgid "A ranging needs at least one brother."
msgstr "Для вилазки потрібен щонайменше один побратим."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "A recruit holds no office until he says the words."
msgstr "Новобранець не обіймає посади, доки не промовить слова."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid "A recruit joins an order only when he says the words."
msgstr "Новобранець вступає до ордену лише тоді, коли промовить слова."

#. module: nights_watch
#: model:ir.model.fields,help:nights_watch.field_nw_take_black_wizard__castle_id
msgid ""
"A recruit trains under the master-at-arms of the castle he is sent to, and "
"cannot say the words until he has one."
msgstr "Новобранець навчається в майстра зброї того замку, куди його направлено, і не може промовити слова, доки замку немає."
"Новобранець навчається в майстра зброї того замку, куди його направлено, і "
"не може промовити слова, доки замку немає."

#. module: nights_watch
#: model:ir.model.constraint,message:nights_watch.constraint_nw_role_code_uniq
msgid "A role with this code already exists."
msgstr "Посада з таким кодом уже існує."

#. module: nights_watch
#: model:nw.brother,notable_deed:nights_watch.brother_jeren
msgid "A septon's bastard, and as weak as a girl on the training yard."
msgstr "Байстрюк септона, і на дворі для вправ слабкий, наче дівчина."

#. module: nights_watch
#: model:ir.model.fields,help:nights_watch.field_nw_brother__serves_id
msgid "A steward is assigned to a senior brother he serves."
msgstr "Стюарда призначають старшому побратимові, якому він служить."

#. module: nights_watch
#. odoo-python
#: code:addons/nights_watch/models/nw_brother.py:0
msgid ""
"A steward serves a senior brother of his own castle. %(senior)s is quartered"
" at \"%(castle)s\", and %(name)s is not."
msgstr "Стюард служить старшому побратимові свого замку. %(senior)s квартирує в «%(castle)s», а %(name)s — ні."

#. module: nights_watch
#: model:nw.castle,description:nights_watch.castle_greyguard
msgid "Abandoned castle, half fallen into ruin."
msgstr "Покинутий замок, наполовину обернений на руїни."

#. module: nights_watch
#: model:ir.model.fields,field_description:nights_watch.field_nw_brother__active
#: model:ir.model.fields,field_description:nights_watch.field_nw_role__active
