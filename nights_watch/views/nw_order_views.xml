<odoo>

    <record id="view_nw_order_list" model="ir.ui.view">
        <field name="name">nw.order.list</field>
        <field name="model">nw.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="member_count"/>
            </list>
        </field>
    </record>

    <record id="view_nw_order_form" model="ir.ui.view">
        <field name="name">nw.order.form</field>
        <field name="model">nw.order</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Rangers"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <page string="Firsts" name="heads">
                            <field name="head_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="castle_id"/>
                                    <field name="role_id"/>
                                </list>
                            </field>
                        </page>
                        <group>
                            <field name="sequence"/>
                            <field name="member_count"/>
                        </group>
                    </group>
                    <group string="Duties">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Members" name="members">
                            <field name="member_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="role_id"/>
                                    <field name="castle_id"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nw_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">nw.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_nw_order"
              parent="menu_nw_config_root"
              action="action_nw_order"
              name="Orders"
              sequence="10"/>

</odoo>
