<odoo>

    <record id="view_partner_form_nights_watch" model="ir.ui.view">
        <field name="name">res.partner.form.nights.watch</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//notebook" position="inside">
                <page string="Night's Watch" name="nights_watch">
                    <group>
                        <group>
                            <field name="is_nw_recruit"/>
                            <field name="nw_recruit_order_id" invisible="not is_nw_recruit"/>
                        </group>
                        <group>
                            <field name="nw_recruit_brother_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
