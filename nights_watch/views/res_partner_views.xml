<odoo>

    <record id="view_partner_form_nights_watch" model="ir.ui.view">
        <field name="name">res.partner.form.nights.watch</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet" position="before">
                <header>
                    <button name="%(nights_watch.action_nw_take_black_wizard)d" type="action"
                            string="Take the Black" class="btn-primary"
                            invisible="not nw_can_take_the_black"/>
                    <field name="nw_can_take_the_black" invisible="1"/>
                    <field name="nw_recruit_brother_id" invisible="1"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
